# Python 缓存（字节码里会嵌入本机绝对路径）
__pycache__/
*.pyc
*.pyo

# 运行时产生的文件
tray_pid.txt
tray_debug.log
_dbg*.txt
_hidcap.log

# 个人设置（刷新间隔 / 开机自启开关）
tray_config.json

# 个人设备表（每台电脑的外设不一样，不进仓库）
devices.json
devices.json.tmp

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
build/
dist/

# 打包脚本的生成物（installer.iss 由 build_installer.py 注入版本号生成）
installer/_build.iss

# 本地调试用的一次性脚本 / 草稿
_*.py
_new_*.txt
.git_old_backup/
